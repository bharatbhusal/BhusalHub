FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine AS build
WORKDIR /src

COPY src/api/BhusalHub.Core/BhusalHub.Core.csproj BhusalHub.Core/
COPY src/api/BhusalHub.Data/BhusalHub.Data.csproj BhusalHub.Data/
COPY src/api/BhusalHub.Api/BhusalHub.Api.csproj BhusalHub.Api/
RUN dotnet restore BhusalHub.Api/BhusalHub.Api.csproj

COPY src/api/ .
RUN dotnet publish BhusalHub.Api/BhusalHub.Api.csproj \
    --configuration Release \
    --output /app

FROM mcr.microsoft.com/dotnet/aspnet:9.0-alpine AS runtime
WORKDIR /app
COPY --from=build /app .
EXPOSE 8080
ENTRYPOINT ["dotnet", "BhusalHub.Api.dll"]
